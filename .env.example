# AxonFlow Enterprise — Environment Configuration
#
# Copy this file to .env and fill in the values from your welcome bundle.
# Do NOT commit .env to version control.

# ---------------------------------------------------------------------------
# Container Registry
# ---------------------------------------------------------------------------
# Uncomment exactly one line below, matching the registry you authenticated
# with during setup. Both registries contain identical images.
#
# GHCR — recommended for GCP, Azure, on-prem, or mixed environments:
# AXONFLOW_REGISTRY=ghcr.io/getaxonflow
#
# Amazon ECR — recommended for AWS-hosted deployments:
# AXONFLOW_REGISTRY=686831565523.dkr.ecr.us-east-1.amazonaws.com

# ---------------------------------------------------------------------------
# Image Digests
# ---------------------------------------------------------------------------
# Paste the SHA256 digests from your welcome bundle. Use the digest set that
# matches your chosen registry (GHCR and ECR digests differ).
AGENT_DIGEST=sha256:replace-with-digest-from-welcome-bundle
ORCHESTRATOR_DIGEST=sha256:replace-with-digest-from-welcome-bundle
PORTAL_DIGEST=sha256:replace-with-digest-from-welcome-bundle
PORTAL_UI_DIGEST=sha256:replace-with-digest-from-welcome-bundle
PROMETHEUS_DIGEST=sha256:replace-with-digest-from-welcome-bundle
GRAFANA_DIGEST=sha256:replace-with-digest-from-welcome-bundle

# ---------------------------------------------------------------------------
# Platform Version
# ---------------------------------------------------------------------------
# The version of AxonFlow you are deploying. Match the version in your
# welcome bundle.
AXONFLOW_VERSION=9.3.0

# ---------------------------------------------------------------------------
# Environment (evaluation vs production)
# ---------------------------------------------------------------------------
# Controls dev-only conveniences on the agent. FAIL-CLOSED: anything other
# than an explicit non-production value is treated as production (the
# docker-compose default if you remove this line is `production`).
#
#   (unset) / production  → the dev-mode token endpoint POST /api/v1/dev/token
#                           is NOT registered (404). Mint user tokens via your
#                           IdP/app instead.
#   development           → enables POST /api/v1/dev/token so the README
#                           "first policy test" can mint an evaluation
#                           user_token directly from your Basic credential.
#
# Fail-closed by default: this line is COMMENTED OUT, so an unset value resolves
# to `production` and the dev-token minter is absent. ⚠️  For an EVALUATION
# stack ONLY, uncomment the line below to enable the README "first policy test".
# Never enable `development` on a production deployment.
# AXONFLOW_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Password for the bundled PostgreSQL instance. Choose a strong password.
AXONFLOW_DB_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Organization
# ---------------------------------------------------------------------------
# Your organization identifier, provided by AxonFlow.
AXONFLOW_ORG_ID=replace-with-your-org-id

# ---------------------------------------------------------------------------
# License
# ---------------------------------------------------------------------------
# Your Enterprise license key, delivered via secure channel (1Password).
AXONFLOW_LICENSE_KEY=replace-with-your-license-key

# ---------------------------------------------------------------------------
# Customer Portal Admin Credential
# ---------------------------------------------------------------------------
# Bootstrap password for logging into the Customer Portal (http://localhost:3000)
# as your deployment org. On first boot the portal sets this as the login
# password for AXONFLOW_ORG_ID, so you can sign in immediately — no manual SQL.
# Log in with: org = your AXONFLOW_ORG_ID, password = this value.
#
# This is the BOOTSTRAP credential only: once you change the password (in the
# portal UI, or with ./reset-portal-credential.sh) the new password sticks and
# this env var no longer overwrites it on restart. Lost it? Run
# ./reset-portal-credential.sh to set a new one.
#
# Choose a strong password (16+ characters recommended).
AXONFLOW_PORTAL_ADMIN_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Internal Service Authentication (G1 — required as of v8.3.x)
# ---------------------------------------------------------------------------
# 32 random bytes (64 hex characters) shared by agent + orchestrator +
# customer-portal so the portal can call internal agent endpoints like
# /static-policies/effective. Without this the unified-policies UI 401s
# every system policy lookup. Mirrors the InternalServiceSecret ECS
# secret in CloudFormation.
#
# Generate with: openssl rand -hex 32
AXONFLOW_INTERNAL_SERVICE_SECRET=replace-with-output-of-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# JWT Signing Secret (G2 — required as of v8.3.x)
# ---------------------------------------------------------------------------
# 32 random bytes (64 hex characters) used to sign + validate user JWTs
# at the agent. Mirrors the JWTSecret ECS secret in CloudFormation.
#
# Generate with: openssl rand -hex 32
AXONFLOW_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Admin API Key (optional — required only when DEPLOYMENT_MODE=saas)
# ---------------------------------------------------------------------------
# The customer-portal admin auth middleware enforces X-Admin-API-Key on
# /api/v1/admin/* when DEPLOYMENT_MODE=saas + ENVIRONMENT=production
# (#2287). In the bundled in-vpc-enterprise mode this is unused; leave
# blank.
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# LLM Provider API Keys
# ---------------------------------------------------------------------------
# Set at least one. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# PII Enforcement Action
# ---------------------------------------------------------------------------
# How the agent handles critical PII (NIK, NPWP, Aadhaar, SSN, etc.). PII_ACTION
# applies on BOTH planes — the request (the /api/v1/decide verdict) and the
# response (the check-output redaction a gateway/MCP proxy runs on a returned
# tool response).
#   redact = the request is allowed through (the /api/v1/decide verdict is
#            allow, not deny — the call proceeds, it is not hard-blocked) and
#            critical PII in the RESPONSE is masked-and-forwarded (e.g. NIK ->
#            [REDACTED] via check-output). Note: a gateway/MCP proxy forwards
#            the request arguments to the backend unchanged — masking that
#            matters here is on the response. Default, and the right posture for
#            conversational / chat assistants (Claude Desktop), where a hard
#            block on every PII-bearing message is too blunt and the goal is to
#            keep the assistant useful while keeping PII out of the model's
#            context and out of cross-border flows.
#   block  = hard-stop on critical PII: DENY on the request plane AND BLOCK a
#            critical-PII response (the response is dropped, not masked — this is
#            the "[MCP] Response blocked by Indonesia PII detection" path).
#            Choose this for regulated evaluations or batch/data pipelines that
#            must reject rather than proceed on a masked copy.
#   warn / log = detect only; the value is forwarded UNREDACTED (signal, not
#            enforcement).
#
# This is a deployment-global setting (it applies to every tenant/org served by
# this deployment). Per-tenant or per-team posture is not configurable today —
# see the "Known limitation" note below.
PII_ACTION=redact
#
# Known limitation / roadmap: PII_ACTION is resolved once at boot and is global
# to the deployment — there is no per-tenant or per-team override yet. A team
# that needs redact while another needs block currently requires separate
# deployments. Per-tenant policy posture is tracked on the Decision Mode policy
# hierarchy roadmap (axonflow-enterprise #2426, WS5).

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
# Password for the Grafana admin user, must be 16+ characters. Used to log in
# at http://localhost:3001.
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Observability (OTel collector + Tempo)
# ---------------------------------------------------------------------------
# The bundled OTel collector receives Decision Mode spans from the agent
# and orchestrator. Tempo stores them for the Decision Mode Traces
# dashboard at http://localhost:3001/d/decision-mode-traces.
#
# Defaults are the standard OTLP and Tempo ports. Change only if the
# host machine already binds these ports.
TEMPO_HTTP_PORT=3200
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
