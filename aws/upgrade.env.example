# Copy to aws/upgrade.env and fill in for your deployment.
# Used by upgrade.sh (and mirror-images-to-your-ecr.sh) so you can run
# `./upgrade.sh <version>` with no flags.

# The CloudFormation stack to upgrade.
STACK_NAME=axonflow-prod

# Your ECR registry (WITHOUT image name), same value as the stack's
# ContainerImageRegistry parameter.
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/axonflow

# Optional: AWS region. Derived from ECR_REGISTRY if omitted.
# REGION=us-east-1

# Optional: S3 URL of an updated template to roll during the upgrade.
# Leave unset to reuse the stack's existing template (image-tag-only upgrade).
# TEMPLATE_URL=https://my-bucket.s3.amazonaws.com/axonflow/cloudformation-ecs-fargate.yaml

# GHCR pull credentials from your AxonFlow welcome bundle (used to pull the
# images before pushing them to your ECR). Prefer exporting these in your shell
# over committing them here.
AXONFLOW_GHCR_USER=your-ghcr-username
AXONFLOW_GHCR_TOKEN=your-read-packages-token
